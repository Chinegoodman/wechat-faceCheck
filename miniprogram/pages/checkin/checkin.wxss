page {
  min-height: 100vh;
  background: #ffffff;
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #ffffff;
}

.camera {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.header {
  position: absolute;
  top: 32rpx;
  left: 24rpx;
  z-index: 3;
}

.close-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #3b82f6;
  font-size: 56rpx;
  line-height: 64rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.88);
}

.tips {
  position: absolute;
  top: 220rpx;
  left: 50%;
  z-index: 3;
  transform: translateX(-50%);
  width: 100%;
  padding: 0 48rpx;
  box-sizing: border-box;
  text-align: center;
}

.title {
  font-size: 56rpx;
  font-weight: 600;
  color: #111111;
}

.subtitle {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(17, 17, 17, 0.68);
}

.capture-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  width: 460rpx;
  height: 460rpx;
  transform: translate(-50%, -38%);
  border-radius: 50%;
  box-sizing: border-box;
  border: 10rpx solid rgba(88, 187, 255, 0.95);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.96) inset;
}

.capture-ring-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-shadow: inset 0 0 0 9999rpx rgba(255, 255, 255, 0.32);
}

.mask {
  position: absolute;
  z-index: 1;
  background: rgba(255, 255, 255, 0.84);
}

.mask.top {
  top: 0;
  left: 0;
  right: 0;
  height: calc(50% - 230rpx + 17%);
}

.mask.bottom {
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(50% - 230rpx - 17%);
}

.mask.left {
  top: calc(50% - 230rpx + 17%);
  left: 0;
  width: calc(50% - 230rpx);
  height: 460rpx;
}

.mask.right {
  top: calc(50% - 230rpx + 17%);
  right: 0;
  width: calc(50% - 230rpx);
  height: 460rpx;
}

.footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 96rpx;
  z-index: 3;
  padding: 0 48rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  text-align: center;
}

.status {
  font-size: 28rpx;
  color: #111111;
  margin-bottom: 20rpx;
}

.detect-meta {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 28rpx;
  font-size: 22rpx;
  color: rgba(17, 17, 17, 0.68);
}

.capture-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #50b7ff, #2563eb);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.capture-path {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: rgba(17, 17, 17, 0.64);
  word-break: break-all;
}
