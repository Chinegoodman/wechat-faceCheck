page {
  min-height: 100vh;
  background: #eef6ff;
}

.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #eef6ff;
}

.camera {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.page::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: radial-gradient(circle 260rpx at 50% calc(50% + 62rpx), transparent 0, transparent 258rpx, rgba(240, 249, 255, 0.72) 260rpx, rgba(240, 249, 255, 0.72) 100%);
}

.header {
  position: absolute;
  top: 72rpx;
  left: 32rpx;
  z-index: 4;
}

.close-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 38rpx rgba(15, 23, 42, 0.14);
  backdrop-filter: blur(18rpx);
}

.close-line {
  position: absolute;
  width: 40rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #0f172a;
}

.line-a {
  transform: rotate(45deg);
}

.line-b {
  transform: rotate(-45deg);
}

.tips {
  position: absolute;
  top: 188rpx;
  left: 50%;
  z-index: 3;
  transform: translateX(-50%);
  width: 100%;
  padding: 0 56rpx;
  box-sizing: border-box;
  text-align: center;
}

.title {
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #0f172a;
  text-shadow: 0 2rpx 18rpx rgba(255, 255, 255, 0.72);
}

.subtitle {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2563eb;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 30rpx rgba(37, 99, 235, 0.12);
}

.capture-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  width: 520rpx;
  height: 520rpx;
  transform: translate(-50%, -38%);
  border-radius: 50%;
  box-sizing: border-box;
  border: 8rpx solid rgba(56, 189, 248, 0.95);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.98) inset, 0 0 42rpx rgba(14, 165, 233, 0.34);
}

.capture-ring-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.mask {
  display: none;
}

.footer {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 48rpx;
  z-index: 3;
  padding: 0 36rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  text-align: center;
}

.status-card {
  padding: 28rpx 28rpx 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 22rpx 60rpx rgba(15, 23, 42, 0.16);
  backdrop-filter: blur(18rpx);
}

.status {
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #0f172a;
}

.detect-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.detect-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
}

.detect-pill.active {
  color: #047857;
  background: #d1fae5;
}

.face-box-text {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #64748b;
  word-break: break-all;
}

.retake-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 1;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #38bdf8, #2563eb);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(37, 99, 235, 0.28);
}

.retake-btn::after {
  border: none;
}

.capture-path {
  margin-top: 20rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: #64748b;
  word-break: break-all;
}
