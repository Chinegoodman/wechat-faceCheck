<view class="page">
  <camera
    id="checkinCamera"
    class="camera"
    device-position="front"
    flash="off"
    frame-size="medium"
    bindinitdone="handleCameraReady"
    binderror="handleCameraError"
  ></camera>

  <view class="mask top"></view>
  <view class="mask bottom"></view>
  <view class="mask left"></view>
  <view class="mask right"></view>

  <cover-view class="header">
    <cover-view class="close-btn" bindtap="goBack">
      <cover-view class="close-line line-a"></cover-view>
      <cover-view class="close-line line-b"></cover-view>
    </cover-view>
  </cover-view>

  <view class="tips">
    <view class="title">拿起手机，眨眨眼</view>
    <view class="subtitle">将人脸保持在圆形区域中央</view>
  </view>

  <view class="capture-ring">
    <view class="capture-ring-inner"></view>
  </view>

  <view class="footer">
    <view class="status-card">
      <view class="status">{{statusText}}</view>
      <view class="detect-meta">
        <text class="detect-pill {{detecting ? 'active' : ''}}">自动检测：{{detecting ? '运行中' : '准备中'}}</text>
        <text wx:if="{{detectFrameCount}}" class="detect-pill">帧数：{{detectFrameCount}}</text>
      </view>
      <view wx:if="{{lastFaceBoxText}}" class="face-box-text">人脸框：{{lastFaceBoxText}}</view>
      <button wx:if="{{lastCapturePath}}" class="retake-btn" bindtap="retakeFrame" loading="{{capturing}}" disabled="{{capturing || !cameraReady}}">
        重新抓拍
      </button>
      <view wx:if="{{lastCapturePath}}" class="capture-path">最近抓拍：{{lastCapturePath}}</view>
    </view>
  </view>
</view>
